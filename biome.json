{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "plugins": [
    "./tools/lint/no-active-element.grit",
    "./tools/lint/no-add-event-listener.grit",
    "./tools/lint/no-captured-state.grit",
    "./tools/lint/no-document-query.grit",
    "./tools/lint/no-dollar-lookup.grit",
    "./tools/lint/no-store-alias.grit",
    "./tools/lint/no-store-import-alias.grit",
    "./tools/lint/no-store-writes.grit",
    "./tools/lint/pure-board-helpers.grit",
    "./tools/lint/pure-templates.grit",
    "./tools/lint/typed-widgets.grit"
  ],
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "internal/planningui/static/**/*.js",
      "!internal/planningui/static/modules/vendor-preact.js",
      "tools/vendor/*.js",
      "tools/*.mjs",
      "internal/planningui/static/**/*.css",
      "tests/**/*.js",
      "tests/**/*.mjs",
      ".pi/extensions/*.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": { "quoteStyle": "single", "semicolons": "always" }
  },
  "css": {
    "formatter": { "enabled": true },
    "linter": { "enabled": true }
  },
  "html": { "formatter": { "enabled": false } },
  "assist": { "actions": { "source": { "organizeImports": "off" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "noUndeclaredVariables": "error",
        "noUnusedVariables": "error"
      },
      "style": {
        "useTemplate": "warn",
        "noDescendingSpecificity": "warn"
      },
      "suspicious": {
        "useIterableCallbackReturn": "warn",
        "noImportCycles": "error"
      },
      "complexity": {
        "noImportantStyles": "warn",
        "useOptionalChain": "warn"
      }
    }
  }
}
