language js

// Planning UI guardrail, run by Biome in `make check-web`.
// A store view under another name would escape the write rule.
// GritQL regexes must not use capture groups: a group binds a variable.

or { `const $alias = state`, `let $alias = state`, `const $alias = pointer`, `let $alias = pointer` } as $bind where {
  $filename <: r".*/internal/planningui/static/.*",
  register_diagnostic(
    span=$bind,
    message="Do not alias a store view; read it as state or pointer.",
    severity="error"
  )
}
