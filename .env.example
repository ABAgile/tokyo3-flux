# Local Compose stack. Configure secrets before starting Flux.
# The bundled database uses one development, non-SSL URL and a persistent volume.
FLUX_PORT=8080
FLUX_BIND_ADDR=127.0.0.1

# Standalone production uses separate runtime/admin credentials.
# FLUX_DATABASE_URL=postgres://flux_runtime@127.0.0.1:5432/flux?sslmode=verify-full
# FLUX_ADMIN_DATABASE_URL=postgres://flux_admin@127.0.0.1:5432/flux?sslmode=verify-full
# FLUX_DB_CERT=
# FLUX_DB_KEY=
# FLUX_DB_CA=  # falls back to FLUX_WORKLOAD_CA
# FLUX_ADMIN_DB_CERT=
# FLUX_ADMIN_DB_KEY=
# FLUX_ADMIN_DB_CA=
# FLUX_ADDR=127.0.0.1:8080

# Browser OAuth uses read_user. Generate session key: openssl rand -hex 32
FLUX_SESSION_KEY=replace-with-64-hex-characters
FLUX_GITLAB_URL=https://gitlab.example.com
FLUX_GITLAB_OAUTH_CLIENT_ID=replace-with-gitlab-oauth-client-id
FLUX_GITLAB_OAUTH_CLIENT_SECRET=replace-with-gitlab-oauth-client-secret
FLUX_GITLAB_OAUTH_REDIRECT_URL=http://localhost:8080/auth/callback

# Optional server-only read_api credential; empty disables observations, not planning.
FLUX_GITLAB_SERVICE_TOKEN=
FLUX_GITLAB_REFRESH_INTERVAL=1m
# Optional targeted webhook secret: openssl rand -hex 32. Requires nonzero refresh.
FLUX_GITLAB_WEBHOOK_SECRET=

# Native machine reads: token >=32 characters, explicit viewer membership required.
FLUX_API_SUBJECT=pi-reader
FLUX_API_TOKEN=
# Client/Pi only: HTTPS origin, or HTTP loopback fixture; no path/query/credentials.
FLUX_API_URL=
FLUX_WORKSPACE=
