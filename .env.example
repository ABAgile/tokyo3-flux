# Optional Compose settings.
COMPOSE_PROJECT_NAME=tokyo3_flux
VERSION=dev-docker
TZ=Asia/Taipei
FLUX_PORT=8080
FLUX_RECONCILE_INTERVAL=5m

# Self-hosted GitLab. The container must be able to resolve and reach this URL.
FLUX_GITLAB_URL=https://gitlab.abagile.com
# Aggregate issues from this group and all of its subgroups/projects.
FLUX_GITLAB_GROUP=tokyo3
# Optional; when empty Flux uses the current GitLab milestone description.
FLUX_SPRINT_GOAL=
FLUX_GITLAB_BLOCKED_LABELS=status::blocked,blocked

# Restricted GitLab token used only for unattended reconciliation.
FLUX_GITLAB_SERVICE_TOKEN=replace-with-a-restricted-token

# Must match the GitLab group webhook secret token. If group webhooks are
# unavailable in your GitLab edition, use this same hook on each project.
FLUX_GITLAB_WEBHOOK_SECRET=replace-with-a-random-webhook-secret

# Optional API endpoint and read-only machine credential for API-backed Pi tools.
# The endpoint is the Flux server origin; Pi requests /api/today server-side.
FLUX_API_URL=
# Generate: openssl rand -hex 32 when enabling API-backed Pi access.
FLUX_API_TOKEN=

# Generate: openssl rand -hex 32
FLUX_SESSION_KEY=replace-with-64-hex-characters

# Create a GitLab OAuth application and register this exact callback URL.
FLUX_GITLAB_OAUTH_CLIENT_ID=replace-with-gitlab-oauth-client-id
FLUX_GITLAB_OAUTH_CLIENT_SECRET=replace-with-gitlab-oauth-client-secret
FLUX_GITLAB_OAUTH_REDIRECT_URL=http://localhost:8080/auth/callback
